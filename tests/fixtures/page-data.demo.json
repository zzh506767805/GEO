 "contents": [
  {
   "no": 5,
   "type": "xhs",
   "title": "拱墅区带娃买面包｜配料表我是这么看的",
   "status": "preview",
   "origin": "asked",
   "period": "2026-10-05",
   "forQuestion": "",
   "reason": "你点名要一条小红书笔记，用的是同一个主题。",
   "summary": "",
   "whereToPost": "",
   "tip": "配 3 到 4 张图：门头、全麦吐司切面、配料表特写。",
   "tags": [
